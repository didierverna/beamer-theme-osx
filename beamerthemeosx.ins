\endpreamble

\postamble

  \outFileName ends here

\endpostamble

\usedir{tex/latex/beamertheme-osx}

\generate{%
  \file{beamerthemeosx.sty}{\from{beamerthemeosx.dtx}{theme}}
  \file{beamerinnerthemeosx.sty}{\from{beamerthemeosx.dtx}{inner}}
  \file{beamerouterthemeosx.sty}{\from{beamerthemeosx.dtx}{outer}}
  \file{beamercolorthemeosx.sty}{\from{beamerthemeosx.dtx}{color}}
  \file{beamerfontthemeosx.sty}{\from{beamerthemeosx.dtx}{font}}
}

\endbatchfile

